# Local dev (recommended): leave NEXT_PUBLIC_API_URL unset.
# Admin calls /api/* on the same host → Next.js proxies to the backend (no CORS).

# Where Next.js proxies /api/* (server-side only)
API_PROXY_TARGET=http://127.0.0.1:3001

# Only set when the browser must call a remote API directly (production split domains):
# NEXT_PUBLIC_API_URL=https://api.tenkhee.mn
